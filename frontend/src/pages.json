	"tabBar": {
		"color": "#FBFBFC",
		"selectedColor": "#CA7B44",
		"borderStyle": "black",
		"backgroundColor": "#151419",
		"iconWidth": "21px",
		"fontSize": "12px",
		"list": [
			{
				"pagePath": "pages/project/index",
        "iconPath": "static/images/tab/tab-market.png",
        "selectedIconPath": "static/images/tab/tab-market-active.png",
				"text": "%tabBar.market%"
			},
			{
				"pagePath": "pages/order/index",
				"iconPath": "static/images/tab/tab-asset.png",
				"selectedIconPath": "static/images/tab/tab-asset-active.png",
				"text": "%tabBar.assets%"
			},
			{
				"pagePath": "pages/user/index",
				"iconPath": "static/images/tab/tab-user.png",
				"selectedIconPath": "static/images/tab/tab-user-active.png",
				"text": "%tabBar.profile%"
			}
		]
	},
	"easycom": {
		"autoscan": true,
		// 注意一定要放在custom里，否则无效，https://ask.dcloud.net.cn/question/131175
		"custom": {
			"^u--(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^up-(.*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^u-([^-].*)": "@/uni_modules/uview-plus/components/u-$1/u-$1.vue",
			"^ly-(.*)" : "@/uni_modules/ly-charts/components/ly-$1/ly-$1.vue"
		}
	}
