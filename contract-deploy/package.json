  "description": "",
  "private": true,
  "dependencies": {
    "@erc3643org/erc-3643": "^4.1.3",
    "@midwayjs/bootstrap": "^3.12.0",
    "@midwayjs/core": "^3.12.0",
    "@midwayjs/decorator": "^3.20.19",
    "@midwayjs/info": "^3.12.0",
    "@midwayjs/koa": "^3.12.0",
    "@midwayjs/logger": "^3.1.0",
    "@midwayjs/validate": "^3.12.0",
    "@onchain-id/solidity": "^2.2.1",
    "ethers": "^6.16.0",
    "mysql": "^2.18.1",
    "prisma": "^6.19.1",
    "web3": "^4.16.0"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.12.0",
    "@prisma/client": "^6.19.1",
    "@types/jest": "^29.2.0",
    "@types/node": "14",
    "cross-env": "^6.0.0",
    "dotenv": "^17.2.3",
    "jest": "^29.2.2",
    "mwts": "^1.3.0",
    "mwtsc": "^1.4.0",
    "ts-jest": "^29.0.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "test:setup": "node scripts/setup-test-db.js && node scripts/migrate-test-db.js",
    "test": "cross-env NODE_ENV=unittest jest",
    "test:all": "npm run test:setup && npm run test",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "mwtsc --cleanOutDir"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "anonymous",
  "license": "MIT",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
